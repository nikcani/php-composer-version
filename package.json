{
  "name": "@nikcani/php-composer-version",
  "description": "A small CLI tool that bumps versions of php-composer packages, similar to how npm version works.",
  "homepage": "https://github.com/nikcani/php-composer-version",
  "version": "1.3.0",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikcani/php-composer-version.git"
  },
  "scripts": {
    "prettier": "prettier . --write"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/ramda": "^0.30.2",
    "chalk": "^5.4.1",
    "fs-extra": "^11.3.0",
    "ramda": "^0.30.1",
    "semver": "^7.7.2",
    "simple-git": "^3.28.0"
  },
  "devDependencies": {
    "prettier": "3.5.3"
  },
  "files": [
    "src",
    "package.json",
    "package-lock.json",
    "README.md"
  ],
  "main": "src/index.js",
  "bin": {
    "php-composer-version": "./src/index.js"
  },
  "keywords": [
    "php",
    "composer",
    "node",
    "bin",
    "package.json",
    "composer.json",
    "git",
    "tag",
    "package"
  ],
  "license": "MIT",
  "type": "module"
}
